#include <stdio.h>

// Enum për nivelin e nxenesit
enum Level {
    BEGINNER = 1,
    INTERMEDIATE,
    ADVANCED,
    EXPERT
};

int main() {
    int choice;

    int validCount = 0;
    int invalidCount = 0;

    // Loop për 3 teste
    for (int i = 1; i <= 3; i++) {

        printf("\nZgjedhja %d:\n", i);
        printf("1 - Beginner\n");
        printf("2 - Intermediate\n");
        printf("3 - Advanced\n");
        printf("4 - Expert\n");
        printf("Zgjedhni nje nivel: ");
        scanf("%d", &choice);

        // Kontroll i input-it
        if (choice < 1 || choice > 4) {
            printf("Input i pavlefshem!\n");
            invalidCount++;
            continue;
        }

        validCount++;

        // Përdorimi real i enum
        enum Level level = choice;

        // Switch për reagim
        switch (level) {
            case BEGINNER:
                printf("Ju jeni fillestar. Filloni me bazat.\n");
                break;

            case INTERMEDIATE:
                printf("Ju keni njohuri mesatare. Vazhdoni praktiken.\n");
                break;

            case ADVANCED:
                printf("Nivel i avancuar. Punoni me projekte me te veshtira.\n");
                break;

            case EXPERT:
                printf("Ekspert! Mund te ndihmoni te tjeret.\n");
                break;

            default:
                // teknikisht nuk duhet te ndodhë për shkak të kontrollit
                printf("Gabim i papritur.\n");
        }
    }

    // Statistikat
    printf("\n--- Statistikat ---\n");
    printf("Zgjedhje valide: %d\n", validCount);
    printf("Zgjedhje invalide: %d\n", invalidCount);

    return 0;
}
