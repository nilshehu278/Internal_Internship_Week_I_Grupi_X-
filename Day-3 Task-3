#include <stdio.h>

int main() {
    int start, end;

    int count3 = 0, count5 = 0;
    int sum3 = 0, sum5 = 0;

    printf("Vendos vleren fillestare: ");
    scanf("%d", &start);

    printf("Vendos vleren perfundimtare: ");
    scanf("%d", &end);

    // Validimi i intervalit
    if (start > end) {
        printf("Gabim: Interval i pavlefshem.\n");
        return 1;
    }

    printf("\n--- ANALIZA ---\n");

    for (int i = start; i <= end; i++) {

        // Kategoria 1: pjesëtohet me 3
        if (i % 3 == 0) {
            count3++;
            sum3 += i;
        }

        // Kategoria 2: pjesëtohet me 5 por JO me 3
        else if (i % 5 == 0) {
            count5++;
            sum5 += i;
        }
    }

    printf("Intervali: %d - %d\n", start, end);

    printf("Numra pjesëtues me 3: %d | Shuma: %d\n", count3, sum3);
    printf("Numra pjesëtues me 5 (jo 3): %d | Shuma: %d\n", count5, sum5);

    if (sum3 > sum5) {
        printf("Shuma e numrave me 3 eshte me e madhe.\n");
    } else if (sum5 > sum3) {
        printf("Shuma e numrave me 5 (jo 3) eshte me e madhe.\n");
    } else {
        printf("Shumat jane te barabarta.\n");
    }

    return 0;
}
