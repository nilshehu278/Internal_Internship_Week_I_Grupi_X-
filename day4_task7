#include <ctype.h>
#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 10
#define NAME_LENGTH 50

/* ---------------- Data model (Final Version) ---------------- */
typedef enum {
    STATUS_NOT_STARTED,
    STATUS_IN_PROGRESS,
    STATUS_COMPLETED
} StudentStatus;

typedef struct {
    int id;
    char name[NAME_LENGTH];
    int progress; /* 0-100 */
    StudentStatus status;
} Student;

typedef struct {
    Student records[MAX_STUDENTS];
    int count;
    int capacity;
} StudentStore;

/* ---------------- Input helpers ---------------- */
void clearInputBuffer(void) {
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {
        /* consume extra input */
    }
}

int readInt(const char *prompt, int *value) {
    printf("%s", prompt);
    if (scanf("%d", value) != 1) {
        clearInputBuffer();
        return 0;
    }
    return 1;
}

int readLine(const char *prompt, char *buffer, int size) {
    printf("%s", prompt);
    if (fgets(buffer, size, stdin) == NULL) {
        return 0;
    }

    size_t len = strlen(buffer);
    if (len > 0 && buffer[len - 1] == '\n') {
        buffer[len - 1] = '\0';
    }
    return 1;
}

/* ---------------- Business helpers ---------------- */
void initStore(StudentStore *store) {
    store->count = 0;
    store->capacity = MAX_STUDENTS;
}

StudentStatus statusFromProgress(int progress) {
    if (progress <= 0) {
        return STATUS_NOT_STARTED;
    } else if (progress < 100) {
        return STATUS_IN_PROGRESS;
    }
    return STATUS_COMPLETED;
}

const char *statusToText(StudentStatus status) {
    switch (status) {
        case STATUS_NOT_STARTED:
            return "Not Started";
        case STATUS_IN_PROGRESS:
            return "In Progress";
        case STATUS_COMPLETED:
            return "Completed";
        default:
            return "Unknown";
    }
}

int idExists(const StudentStore *store, int id) {
    for (int i = 0; i < store->count; i++) {
        if (store->records[i].id == id) {
            return 1;
        }
    }
    return 0;
}

int findStudentIndexById(const StudentStore *store, int id) {
    for (int i = 0; i < store->count; i++) {
        if (store->records[i].id == id) {
            return i;
        }
    }
    return -1;
}

int isFull(const StudentStore *store) {
    return store->count >= store->capacity;
}

int containsIgnoreCase(const char *text, const char *pattern) {
    if (pattern[0] == '\0') {
        return 1;
    }

    for (int i = 0; text[i] != '\0'; i++) {
        int j = 0;
        while (text[i + j] != '\0' && pattern[j] != '\0' &&
               tolower((unsigned char) text[i + j]) == tolower((unsigned char) pattern[j])) {
            j++;
        }
        if (pattern[j] == '\0') {
            return 1;
        }
    }

    return 0;
}

/* Advice is interpretation, not stored data */
const char *getRecommendation(const Student *student) {
    if (student->progress < 40 && student->status == STATUS_NOT_STARTED) {
        return "Warning: low progress and inactive status. Needs immediate attention.";
    } else if (student->progress >= 40 && student->progress < 80 && student->status == STATUS_IN_PROGRESS) {
        return "Good path: keep improving with regular practice.";
    } else if (student->progress >= 90 && student->status == STATUS_COMPLETED) {
        return "Excellent result: high score with completed status.";
    } else if (student->progress == 0 || (student->progress < 50 && student->status != STATUS_COMPLETED)) {
        return "Needs attention: weak or missing progress.";
    }
    return "Stable progress: continue consistent effort.";
}

void printStudentLine(const Student *student, int rowNo) {
    char progressText[16];
    snprintf(progressText, sizeof(progressText), "%d%%", student->progress);

    printf("%-4d %-6d %-20s %-10s %-15s\n",
           rowNo,
           student->id,
           student->name,
           progressText,
           statusToText(student->status));
}

void printStudentWithRecommendation(const Student *student, int rowNo) {
    printStudentLine(student, rowNo);
    printf("     Advice: %s\n", getRecommendation(student));
}

void printTableHeader(void) {
    printf("%-4s %-6s %-20s %-10s %-15s\n", "No.", "ID", "Name", "Progress", "Status");
    printf("--------------------------------------------------------------\n");
}

/* ---------------- Core features ---------------- */
int addOneStudent(StudentStore *store) {
    if (isFull(store)) {
        printf("Cannot add more students. Array is full (%d/%d).\n", store->count, store->capacity);
        return 0;
    }

    Student *current = &store->records[store->count];

    printf("\n--- Add Student (%d/%d used) ---\n", store->count, store->capacity);

    if (!readInt("Enter ID: ", &current->id)) {
        printf("Invalid ID. Please enter a number.\n");
        return 0;
    }

    if (idExists(store, current->id)) {
        printf("This ID already exists.\n");
        return 0;
    }

    clearInputBuffer();

    if (!readLine("Enter Name: ", current->name, NAME_LENGTH)) {
        printf("Invalid name input.\n");
        return 0;
    }

    if (!readInt("Enter Progress (0-100): ", &current->progress)) {
        printf("Invalid progress. Please enter a number.\n");
        return 0;
    }

    if (current->progress < 0 || current->progress > 100) {
        printf("Progress must be between 0 and 100.\n");
        return 0;
    }

    current->status = statusFromProgress(current->progress);
    store->count++;

    printf("Student added successfully (%d/%d).\n", store->count, store->capacity);
    return 1;
}

void addStudentsLoop(StudentStore *store) {
    char again = 'y';

    if (isFull(store)) {
        printf("Cannot add more students. Array is full (%d/%d).\n", store->count, store->capacity);
        return;
    }

    while ((again == 'y' || again == 'Y') && !isFull(store)) {
        addOneStudent(store);

        if (isFull(store)) {
            printf("Array reached full capacity (%d/%d).\n", store->count, store->capacity);
            break;
        }

        clearInputBuffer();
        printf("Add another student? (y/n): ");
        if (scanf(" %c", &again) != 1) {
            clearInputBuffer();
            printf("Invalid input. Returning to main menu.\n");
            break;
        }
    }
}

void updateStudentProgressMenu(StudentStore *store) {
    int id;
    int newProgress;

    if (store->count == 0) {
        printf("No students available to update.\n");
        return;
    }

    printf("\n--- Update Student Progress (Pointer-based) ---\n");

    if (!readInt("Enter student ID to update: ", &id)) {
        printf("Invalid ID input.\n");
        return;
    }

    int index = findStudentIndexById(store, id);
    if (index == -1) {
        printf("Student with ID %d not found.\n", id);
        return;
    }

    if (!readInt("Enter new progress (0-100): ", &newProgress)) {
        printf("Invalid progress input.\n");
        return;
    }

    if (newProgress < 0 || newProgress > 100) {
        printf("Progress must be between 0 and 100.\n");
        return;
    }

    Student *target = &store->records[index];

    printf("Before update -> ID: %d, Name: %s, Progress: %d%%, Status: %s\n",
           target->id,
           target->name,
           target->progress,
           statusToText(target->status));

    target->progress = newProgress;
    target->status = statusFromProgress(newProgress);

    printf("After update  -> ID: %d, Name: %s, Progress: %d%%, Status: %s\n",
           target->id,
           target->name,
           target->progress,
           statusToText(target->status));
}

void showAllStudents(const StudentStore *store) {
    printf("\n--- All Students (%d/%d) ---\n", store->count, store->capacity);

    if (store->count == 0) {
        printf("No students saved yet.\n");
        return;
    }

    printTableHeader();
    for (int i = 0; i < store->count; i++) {
        printStudentLine(&store->records[i], i + 1);
    }
}

/* ---------------- Search features ---------------- */
void searchById(const StudentStore *store) {
    int id;

    if (!readInt("Enter ID to search: ", &id)) {
        printf("Invalid ID input.\n");
        return;
    }

    int index = findStudentIndexById(store, id);
    if (index == -1) {
        printf("No student found with ID %d.\n", id);
        return;
    }

    printf("\nMatch found:\n");
    printTableHeader();
    printStudentWithRecommendation(&store->records[index], 1);
}

void searchByName(const StudentStore *store) {
    char query[NAME_LENGTH];
    int foundCount = 0;

    clearInputBuffer();
    if (!readLine("Enter full or partial name: ", query, NAME_LENGTH)) {
        printf("Invalid name input.\n");
        return;
    }

    if (query[0] == '\0') {
        printf("Search text cannot be empty.\n");
        return;
    }

    printf("\nMatching students for \"%s\":\n", query);
    printTableHeader();

    for (int i = 0; i < store->count; i++) {
        if (containsIgnoreCase(store->records[i].name, query)) {
            foundCount++;
            printStudentWithRecommendation(&store->records[i], foundCount);
        }
    }

    if (foundCount == 0) {
        printf("No students found by name '%s'.\n", query);
    }
}

void searchStudentsMenu(const StudentStore *store) {
    int option;

    if (store->count == 0) {
        printf("No students available to search.\n");
        return;
    }

    printf("\n--- Search Students ---\n");
    printf("1. Search by ID\n");
    printf("2. Search by name\n");
    printf("Choose search option: ");

    if (!readInt("", &option)) {
        printf("Invalid search option.\n");
        return;
    }

    switch (option) {
        case 1:
            searchById(store);
            break;
        case 2:
            searchByName(store);
            break;
        default:
            printf("Please choose 1 or 2.\n");
    }
}

/* ---------------- Ranking/sorting (Final) ---------------- */
int shouldSwapForRanking(const Student *left, const Student *right) {
    /* 1) Higher progress first */
    if (left->progress < right->progress) {
        return 1;
    }
    if (left->progress > right->progress) {
        return 0;
    }

    /* 2) If same progress, higher status first (Completed > In Progress > Not Started) */
    if (left->status < right->status) {
        return 1;
    }
    if (left->status > right->status) {
        return 0;
    }

    /* 3) If still same, alphabetical name */
    return strcmp(left->name, right->name) > 0;
}

void showRankingByProgress(const StudentStore *store) {
    Student sorted[MAX_STUDENTS];

    if (store->count == 0) {
        printf("No students available for ranking.\n");
        return;
    }

    for (int i = 0; i < store->count; i++) {
        sorted[i] = store->records[i];
    }

    for (int i = 0; i < store->count - 1; i++) {
        for (int j = 0; j < store->count - 1 - i; j++) {
            if (shouldSwapForRanking(&sorted[j], &sorted[j + 1])) {
                Student temp = sorted[j];
                sorted[j] = sorted[j + 1];
                sorted[j + 1] = temp;
            }
        }
    }

    printf("\n--- Ranking (Highest Progress First) ---\n");
    printTableHeader();
    for (int i = 0; i < store->count; i++) {
        printStudentLine(&sorted[i], i + 1);
    }
}

/* ---------------- Main menu ---------------- */
void printMenu(void) {
    printf("\n==== Student Progress Tracker (Final Version) ====\n");
    printf("1. Add students\n");
    printf("2. Show all students\n");
    printf("3. Update student progress (pointer)\n");
    printf("4. Search students + advice\n");
    printf("5. Show ranking (highest progress first)\n");
    printf("0. Exit\n");
    printf("Choose an option: ");
}

int main(void) {
    StudentStore store;
    int choice;

    initStore(&store);
    printf("Welcome to Student Progress Tracker - Final Version!\n");

    while (1) {
        printMenu();

        if (!readInt("", &choice)) {
            printf("Invalid menu option.\n");
            continue;
        }

        switch (choice) {
            case 1:
                addStudentsLoop(&store);
                break;
            case 2:
                showAllStudents(&store);
                break;
            case 3:
                updateStudentProgressMenu(&store);
                break;
            case 4:
                searchStudentsMenu(&store);
                break;
            case 5:
                showRankingByProgress(&store);
                break;
            case 0:
                printf("Goodbye!\n");
                return 0;
            default:
                printf("Please choose 0, 1, 2, 3, 4, or 5.\n");
        }
    }
}
