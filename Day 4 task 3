#include <stdio.h>

int main() {
    int progress[] = {80, 40, 100};
    int completed[] = {1, 0, 1};

    int total = 3;
    int completed_count = 0;
    int sum = 0;

    int max = progress[0];
    int min = progress[0];

    for (int i = 0; i < total; i++) {
        int p = progress[i];

        sum += p;

        if (completed[i] == 1) {
            completed_count++;
        }

        if (p > max) {
            max = p;
        }

        if (p < min) {
            min = p;
        }
    }

    float avg = (float)sum / total;

    printf("📊 RAPORT ANALITIK\n");
    printf("-------------------\n");
    printf("Totali: %d\n", total);
    printf("Te perfunduara: %d\n", completed_count);
    printf("Mesatarja: %.2f\n", avg);
    printf("Max: %d\n", max);
    printf("Min: %d\n", min);

    return 0;
}
