#include <stdio.h>

int main() {
    int mosha;
    char iniciali;
    double piket;
    int opsioni;

    // INPUT
    printf("Shkruaj moshen: ");
    scanf("%d", &mosha);

    printf("Shkruaj inicialin: ");
    scanf(" %c", &iniciali); // space para %c për të shmangur problemin e buffer-it

    printf("Shkruaj piket paraprake: ");
    scanf("%lf", &piket);

    printf("Zgjidh punetorine (1-3): ");
    scanf("%d", &opsioni);

    // KONTROLL MOSHE
    if (mosha < 10 || mosha > 18) {
        printf("\nMosha nuk eshte brenda kufirit per pjesemarrje!\n");
    } else {
        printf("\nMosha eshte e vlefshme per pjesemarrje.\n");
    }

    // KLASIFIKIMI ME IF/ELSE
    if (piket < 50) {
        printf("Statusi: Nevojitet me shume ushtrim\n");
    } else if (piket < 80) {
        printf("Statusi: Gati per vazhdim\n");
    } else {
        printf("Statusi: Gati per sfide\n");
    }

    // SWITCH PER PUNETORINE
    switch (opsioni) {
        case 1:
            printf("Punetoria e zgjedhur: Programim bazik\n");
            break;

        case 2:
            printf("Punetoria e zgjedhur: Web Development\n");
            break;

        case 3:
            printf("Punetoria e zgjedhur: Cybersecurity hyrje\n");
            break;

        default:
            printf("Opsion i pavlefshem per punetori\n");
            break;
    }

    // PËRMBLEDHJE FINALE
    printf("\n--- PERMBLEDHJE ---\n");
    printf("Mosha: %d\n", mosha);
    printf("Iniciali: %c\n", iniciali);
    printf("Piket: %.2f\n", piket);
    printf("Opsioni: %d\n", opsioni);

    return 0;
}
