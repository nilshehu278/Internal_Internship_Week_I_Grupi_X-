#include <stdio.h>

int main() {
    int age;
    float height;
    char grade;

    // Input
    printf("Shkruaj moshen: ");
    scanf("%d", &age);

    printf("Shkruaj gjatesine: ");
    scanf("%f", &height);

    printf("Shkruaj noten (A/B/C): ");
    scanf(" %c", &grade);

    // Output
    printf("\nTe dhenat:\n");
    printf("Mosha: %d\n", age);
    printf("Gjatesia: %f\n", height);
    printf("Nota: %c\n", grade);

    // if else
    if (age >= 18) {
        printf("Je adult\n");
    } else {
        printf("Je minor\n");
    }

    // switch
    switch(grade) {
        case 'A':
            printf("Shkelqyeshem\n");
            break;
        case 'B':
            printf("Mire\n");
            break;
        case 'C':
            printf("Kalueshem\n");
            break;
        default:
            printf("Note e pavlefshme\n");
    }

    return 0;
}
