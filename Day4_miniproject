

#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 10
#define NAME_LENGTH 50

/* Step 1: Status category with enum */
typedef enum {
    STATUS_NOT_STARTED,
    STATUS_IN_PROGRESS,
    STATUS_COMPLETED
} StudentStatus;

/* Step 2: One student record */
typedef struct {
    int id;
    char name[NAME_LENGTH];
    int progress; /* 0-100 */
    StudentStatus status;
} Student;

/* ---------- Input helpers ---------- */
void clearInputBuffer(void) {
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {
        /* clear remaining input */
    }
}

int readInt(const char *prompt, int *value) {
    printf("%s", prompt);
    if (scanf("%d", value) != 1) {
        clearInputBuffer();
        return 0;
    }
    return 1;
}

int readLine(const char *prompt, char *buffer, int size) {
    printf("%s", prompt);
    if (fgets(buffer, size, stdin) == NULL) {
        return 0;
    }

    size_t len = strlen(buffer);
    if (len > 0 && buffer[len - 1] == '\n') {
        buffer[len - 1] = '\0';
    }
    return 1;
}

/* ---------- Business logic ---------- */
StudentStatus statusFromProgress(int progress) {
    if (progress <= 0) {
        return STATUS_NOT_STARTED;
    } else if (progress < 100) {
        return STATUS_IN_PROGRESS;
    }
    return STATUS_COMPLETED;
}

const char *statusToText(StudentStatus status) {
    switch (status) {
        case STATUS_NOT_STARTED:
            return "Not Started";
        case STATUS_IN_PROGRESS:
            return "In Progress";
        case STATUS_COMPLETED:
            return "Completed";
        default:
            return "Unknown";
    }
}

int idExists(const Student students[], int count, int id) {
    for (int i = 0; i < count; i++) {
        if (students[i].id == id) {
            return 1;
        }
    }
    return 0;
}

/*
 * Practical pointer use:
 * - int *count lets function update total number of students.
 * - Student *current points to the exact array slot to fill.
 */
void addStudent(Student students[], int *count) {
    if (*count >= MAX_STUDENTS) {
        printf("Storage is full (max %d students).\n", MAX_STUDENTS);
        return;
    }

    Student *current = &students[*count];

    printf("\n--- Add Student ---\n");

    if (!readInt("Enter ID: ", &current->id)) {
        printf("Invalid ID. Please enter a number.\n");
        return;
    }

    if (idExists(students, *count, current->id)) {
        printf("This ID already exists.\n");
        return;
    }

    clearInputBuffer();

    if (!readLine("Enter Name: ", current->name, NAME_LENGTH)) {
        printf("Invalid name input.\n");
        return;
    }

    if (!readInt("Enter Progress (0-100): ", &current->progress)) {
        printf("Invalid progress. Please enter a number.\n");
        return;
    }

    if (current->progress < 0 || current->progress > 100) {
        printf("Progress must be between 0 and 100.\n");
        return;
    }

    current->status = statusFromProgress(current->progress);
    (*count)++;

    printf("Student added successfully.\n");
}

void showStudents(const Student students[], int count) {
    printf("\n--- All Students ---\n");

    if (count == 0) {
        printf("No students added yet.\n");
        return;
    }

    for (int i = 0; i < count; i++) {
        printf("%d) ID: %d | Name: %s | Progress: %d%% | Status: %s\n",
               i + 1,
               students[i].id,
               students[i].name,
               students[i].progress,
               statusToText(students[i].status));
    }
}

void printMenu(void) {
    printf("\n==== Student Progress Tracker (Version 1) ====\n");
    printf("1. Add student\n");
    printf("2. Show all students\n");
    printf("0. Exit\n");
    printf("Choose an option: ");
}

int main(void) {
    Student students[MAX_STUDENTS];
    int count = 0;
    int choice;

    printf("Welcome to Student Progress Tracker!\n");

    while (1) { /* loop required by assignment */
        printMenu();

        if (!readInt("", &choice)) {
            printf("Invalid menu option.\n");
            continue;
        }

        switch (choice) { /* switch required by assignment */
            case 1:
                addStudent(students, &count);
                break;
            case 2:
                showStudents(students, count);
                break;
            case 0:
                printf("Goodbye!\n");
                return 0;
            default:
                printf("Please choose 0, 1, or 2.\n");
        }
    }
}
