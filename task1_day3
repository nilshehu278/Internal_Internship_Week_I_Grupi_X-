     6	void print_star_pattern(int size) {
     7	    printf("\nPattern me yje:\n");
     8	    for (int row = 1; row <= size; row++) {
     9	        for (int col = 1; col <= row; col++) {
    10	            printf("* ");
    11	        }
    12	        printf("\n");
    13	    }
    14	}
