#include <stdio.h>

int main(void) {
    int start;
    int end;
    int countDivBy3 = 0;
    int countDivBy5Not3 = 0;
    long long sumDivBy3 = 0;
    long long sumDivBy5Not3 = 0;

    printf("=== Day 3 - Task 3: Krahasimi i Shumave ne Interval ===\n");

    printf("Shkruani fillimin e intervalit: ");
    if (scanf("%d", &start) != 1) {
        printf("Input i pavlefshem per fillimin e intervalit.\n");
        return 1;
    }

    printf("Shkruani fundin e intervalit: ");
    if (scanf("%d", &end) != 1) {
        printf("Input i pavlefshem per fundin e intervalit.\n");
        return 1;
    }

    if (start > end) {
        printf("Interval i pavlefshem: fillimi duhet te jete <= fundi.\n");
        return 1;
    }

    for (int number = start; number <= end; number++) {
        if (number % 3 == 0) {
            countDivBy3++;
            sumDivBy3 += number;
        } else if (number % 5 == 0) {
            countDivBy5Not3++;
            sumDivBy5Not3 += number;
        }
    }

    printf("\n--- Rezultatet ---\n");
    printf("Intervali: [%d, %d]\n", start, end);
    printf("Kategoria 1 (pjestohen me 3): numeruesi = %d, shuma = %lld\n", countDivBy3, sumDivBy3);
    printf("Kategoria 2 (pjestohen me 5 por jo me 3): numeruesi = %d, shuma = %lld\n", countDivBy5Not3, sumDivBy5Not3);

    if (sumDivBy3 > sumDivBy5Not3) {
        printf("Shuma me e madhe: Kategoria 1 (pjestohen me 3).\n");
    } else if (sumDivBy5Not3 > sumDivBy3) {
        printf("Shuma me e madhe: Kategoria 2 (pjestohen me 5 por jo me 3).\n");
    } else {
        printf("Shumat jane te barabarta.\n");
    }

    return 0;
}
