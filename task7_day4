   367	        printf("Opsion i pavlefshem ne kerkimin e regjistrimeve.\n");
   368	        return;
   369	    }
   370	
   371	    if (!found) {
   372	        printf("\nAsnje regjistrim nuk u gjet per kriterin e dhene.\n");
   373	    }
   374	}
