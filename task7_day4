   318	void searchRegistrations(const Registration registrations[], int count) {
   319	    int searchOption;
   320	    int found = 0;
320	    int found = 0;
   321	
   322	    if (count == 0) {
   323	        printf("\nNuk ka regjistrime per kerkim.\n");
