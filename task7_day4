   262	int containsIgnoreCase(const char *text, const char *query) {
   263	    size_t textLen = strlen(text);
   264	    size_t queryLen = strlen(query);
   265	
   266	    if (queryLen == 0 || queryLen > textLen) {
   267	        return 0;
   268	    }
   269	
   270	    for (size_t i = 0; i <= textLen - queryLen; i++) {
   271	        size_t j = 0;
   272	        while (j < queryLen && tolower((unsigned char)text[i + j]) == tolower((unsigned char)query[j])) {
   273	            j++;
   274	        }
   275	
   276	        if (j == queryLen) {
   277	            return 1;
   278	        }
   279	    }
   280	
   281	    return 0;
   282	}
