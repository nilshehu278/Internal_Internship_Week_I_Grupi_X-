   155	int addRegistration(Registration *record, const Registration registrations[], int count) {
   156	    if (!readInt("Shkruaj ID-ne (int unik): ", &record->id)) {
   157	        printf("Input i pavlefshem per ID-ne.\n");
   158	        return 0;
   159	    }
   160	
   161	    if (record->id <= 0) {
   162	        printf("ID duhet te jete numer pozitiv.\n");
   163	        return 0;
   164	    }
   165	
   166	    if (idExists(registrations, count, record->id)) {
   167	        printf("ID ekziston tashme. Perdorni nje ID tjeter.\n");
   168	        return 0;
   169	    }
   170	
   171	    if (!readText("Shkruaj emrin: ", record->name, MAX_NAME_LEN)) {
   172	        printf("Input i pavlefshem per emrin.\n");
   173	        return 0;
   174	    }
   175	
   176	    if (!readInt("Shkruaj moshen (int): ", &record->age)) {
   177	        printf("Input i pavlefshem per moshen.\n");
   178	        return 0;
   179	    }
   180	
   181	    if (!readInitial("Shkruaj inicialin (char): ", &record->initial)) {
   182	        printf("Input i pavlefshem per inicialin.\n");
   183	        return 0;
   184	    }
   185	
   186	    if (!readDouble("Shkruaj piket paraprake (double): ", &record->preliminaryPoints)) {
   187	        printf("Input i pavlefshem per piket.\n");
   188	        return 0;
   189	    }
   190	
   191	    if (!readInt("Zgjidh punetorine (1, 2 ose 3): ", &record->workshopOption)) {
   192	        printf("Input i pavlefshem per opsionin e punetorise.\n");
   193	        return 0;
   194	    }
   195	
   196	    if (record->workshopOption < 1 || record->workshopOption > 3) {
   197	        printf("Opsion i pavlefshem per punetorine. Lejohen vetem 1, 2 ose 3.\n");
   198	        return 0;
   199	    }
   200	
   201	    if (!chooseStatus(&record->status)) {
   202	        return 0;
   203	    }
   204	
   205	    return 1;
   206	}
