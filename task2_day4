   163	void listRegistrations(const Registration registrations[], int count) {
   164	    if (count == 0) {
   165	        printf("\nNuk ka regjistrime te ruajtura ende.\n");
   166	        return;
   167	    }
   168	
   169	    printf("\n=== Lista e te Gjitha Regjistrimeve (%d) ===\n", count);
   170	    for (int i = 0; i < count; i++) {
   171	        printf("\nRegjistrimi #%d\n", i + 1);
   172	        printf("Mosha: %d\n", registrations[i].age);
   173	        printf("Iniciali: %c\n", registrations[i].initial);
   174	        printf("Piket paraprake: %.2lf\n", registrations[i].preliminaryPoints);
   175	        printf("Opsioni i punetorise: %d\n", registrations[i].workshopOption);
   176	        printf("Punetoria e zgjedhur: %s\n", getWorkshopName(registrations[i].workshopOption));
   177	        printf("Klasifikimi: %s\n", getReadiness(registrations[i].preliminaryPoints));
   178	        printf("Statusi i moshes: %s\n", getAgeStatus(registrations[i].age));
   179	        printf("Statusi (enum): %s\n", getStatusName(registrations[i].status));
   180	    }
   181	}
