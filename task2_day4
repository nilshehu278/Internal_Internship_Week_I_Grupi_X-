   130	int addRegistration(Registration *record) {
   131	    if (!readInt("Shkruaj moshen (int): ", &record->age)) {
   132	        printf("Input i pavlefshem per moshen.\n");
   133	        return 0;
   134	    }
   135	
   136	    if (!readInitial("Shkruaj inicialin (char): ", &record->initial)) {
   137	        printf("Input i pavlefshem per inicialin.\n");
   138	        return 0;
   139	    }
   140	
   141	    if (!readDouble("Shkruaj piket paraprake (double): ", &record->preliminaryPoints)) {
   142	        printf("Input i pavlefshem per piket.\n");
   143	        return 0;
   144	    }
   145	
   146	    if (!readInt("Zgjidh punetorine (1, 2 ose 3): ", &record->workshopOption)) {
   147	        printf("Input i pavlefshem per opsionin e punetorise.\n");
   148	        return 0;
   149	    }
   150	
   151	    if (record->workshopOption < 1 || record->workshopOption > 3) {
   152	        printf("Opsion i pavlefshem per punetorine. Lejohen vetem 1, 2 ose 3.\n");
   153	        return 0;
   154	    }
   155	
   156	    if (!chooseStatus(&record->status)) {
   157	        return 0;
   158	    }
   159	
   160	    return 1;
   161	}
