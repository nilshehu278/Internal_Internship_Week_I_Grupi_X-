   101	int chooseStatus(RegistrationStatus *status) {
   102	    int statusChoice;
   103	
   104	    printf("Zgjidh statusin:\n");
   105	    printf("1. Fillestar\n");
   106	    printf("2. Ne zhvillim\n");
   107	    printf("3. Gati per sfide\n");
   108	
   109	    if (!readInt("Zgjedhja e statusit: ", &statusChoice)) {
   110	        printf("Input i pavlefshem per statusin. Provoni perseri.\n");
   111	        return 0;
   112	    }
   113	
   114	    switch (statusChoice) {
   115	        case STATUS_FILLSTAR:
   116	            *status = STATUS_FILLSTAR;
   117	            return 1;
   118	        case STATUS_NE_ZHVILLIM:
   119	            *status = STATUS_NE_ZHVILLIM;
   120	            return 1;
   121	        case STATUS_GATI_PER_SFIDE:
   122	            *status = STATUS_GATI_PER_SFIDE;
   123	            return 1;
   124	        default:
   125	            printf("Status i pavlefshem. Lejohen vetem 1, 2 ose 3.\n");
   126	            return 0;
   127	    }
   128	}
