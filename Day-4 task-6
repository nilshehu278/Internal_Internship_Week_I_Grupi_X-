void sortStudentsByProgress(Student *students, int count) {

    if (count == 0) {
        printf("Nuk ka te dhena per renditje.\n");
        return;
    }

    // kopje e array-it (që të mos prishim originalin)
    Student temp[MAX_STUDENTS];

    for (int i = 0; i < count; i++) {
        temp[i] = students[i];
    }

    // Bubble Sort (zbritës)
    for (int i = 0; i < count - 1; i++) {
        for (int j = 0; j < count - i - 1; j++) {
            if (temp[j].progress < temp[j + 1].progress) {

                Student t = temp[j];
                temp[j] = temp[j + 1];
                temp[j + 1] = t;
            }
        }
    }

    // shfaq ranking
    printf("\n===== RANKING SIPAS PROGRESIT =====\n");

    for (int i = 0; i < count; i++) {
        printf("%d. %s - %.2f\n", i + 1, temp[i].name, temp[i].progress);
    }
}
