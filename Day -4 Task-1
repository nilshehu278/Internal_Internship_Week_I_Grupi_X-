#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 5   // kapaciteti maksimal

// enum për statusin
typedef enum {
    ACTIVE,
    INACTIVE
} Status;

// struktura e regjistrimit
typedef struct {
    int id;
    char name[50];
    float progress;
    Status status;
} Student;

// funksion për shtim (me pointer)
void addStudent(Student *students, int *count) {
    if (*count >= MAX_STUDENTS) {
        printf("Nuk mund te shtosh me shume regjistrime! Kapaciteti eshte plote.\n");
        return;
    }

    Student s;

    printf("Sheno ID: ");
    scanf("%d", &s.id);

    printf("Sheno emrin: ");
    scanf(" %[^\n]", s.name);

    printf("Sheno progresin (0 - 100): ");
    scanf("%f", &s.progress);

    // validim i thjeshtë
    if (s.progress >= 50) {
        s.status = ACTIVE;
    } else {
        s.status = INACTIVE;
    }

    students[*count] = s;
    (*count)++;

    printf("Regjistrimi u shtua me sukses!\n");
}

// funksion për shfaqje
void showStudents(Student *students, int count) {
    if (count == 0) {
        printf("Nuk ka regjistrime ende.\n");
        return;
    }

    printf("\n--- LISTA E STUDENTEVE ---\n");

    for (int i = 0; i < count; i++) {
        printf("\nStudent #%d\n", i + 1);
        printf("ID: %d\n", students[i].id);
        printf("Emri: %s\n", students[i].name);
        printf("Progresi: %.2f\n", students[i].progress);

        if (students[i].status == ACTIVE) {
            printf("Statusi: ACTIVE\n");
        } else {
            printf("Statusi: INACTIVE\n");
        }
    }
}

int main() {
    Student students[MAX_STUDENTS];
    int count = 0;
    int choice;

    do {
        printf("\n===== MENU =====\n");
        printf("1. Shto student\n");
        printf("2. Shfaq studentet\n");
        printf("3. Dil\n");
        printf("Zgjedh: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addStudent(students, &count);
                break;

            case 2:
                showStudents(students, count);
                break;

            case 3:
                printf("Duke dale nga programi...\n");
                break;

            default:
                printf("Zgjedhje e pavlefshme!\n");
        }

    } while (choice != 3);

    return 0;
}
