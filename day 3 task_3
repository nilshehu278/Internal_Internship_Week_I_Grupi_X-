#include <stdio.h>

int main() {
    int start, end;

    int count3 = 0, sum3 = 0;
    int count5 = 0, sum5 = 0;

    printf("Shkruaj vleren fillestare: ");
    scanf("%d", &start);

    printf("Shkruaj vleren perfundimtare: ");
    scanf("%d", &end);

    // Kontrolli i input-it
    if (start > end) {
        printf("Interval i pavlefshem!\n");
        return 0;
    }

    // Loop për intervalin
    for (int i = start; i <= end; i++) {

        // Kategoria 1: pjesëtohet me 3
        if (i % 3 == 0) {
            count3++;
            sum3 += i;
        }

        // Kategoria 2: pjesëtohet me 5 por JO me 3
        else if (i % 5 == 0) {
            count5++;
            sum5 += i;
        }
    }

    // Output
    printf("\n--- REZULTATI ---\n");

    printf("Kategoria 1 (pjesëtohet me 3):\n");
    printf("Numra: %d | Shuma: %d\n", count3, sum3);

    printf("Kategoria 2 (pjesëtohet me 5 por jo me 3):\n");
    printf("Numra: %d | Shuma: %d\n", count5, sum5);

    // Krahasimi
    if (sum3 > sum5) {
        printf("Shuma e numrave me 3 eshte me e madhe.\n");
    }
    else if (sum5 > sum3) {
        printf("Shuma e numrave me 5 (jo 3) eshte me e madhe.\n");
    }
    else {
        printf("Shumat jane te barabarta.\n");
    }

    return 0;
}
