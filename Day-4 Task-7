void updateStudent(Student *students, int count) {
    if (count == 0) {
        printf("Nuk ka regjistrime per perditesim.\n");
        return;
    }

    int id;
    printf("Sheno ID e studentit: ");
    scanf("%d", &id);

    for (int i = 0; i < count; i++) {
        if (students[i].id == id) {

            Student *s = &students[i];

            printf("Studenti u gjet: %s\n", s->name);

            // ndryshim i emrit
            printf("Emri i ri: ");
            scanf(" %[^\n]", s->name);

            // ndryshim i progresit
            printf("Progres i ri (0-100): ");
            scanf("%f", &s->progress);

            if (s->progress < 0 || s->progress > 100) {
                printf("Progres i pavlefshem! Vendoset 0.\n");
                s->progress = 0;
            }

            // ndryshim statusi
            s->status = chooseStatus();

            printf("Perditesimi u krye me sukses!\n");
            return;
        }
    }

    printf("Studenti nuk u gjet.\n");
}
