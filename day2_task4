#include <stdio.h>

int main() {
    int mosha, opsioni;
    char iniciali;
    double piket;

    // Marrja e input-it
    printf("Shkruaj moshen: ");
    scanf("%d", &mosha);

    printf("Shkruaj inicialin: ");
    scanf(" %c", &iniciali); // hapësira para %c shmang problemin me newline

    printf("Shkruaj piket paraprake: ");
    scanf("%lf", &piket);

    printf("Zgjidh punetorine (1, 2 ose 3): ");
    scanf("%d", &opsioni);

    // Kontrolli i moshes
    if (mosha < 10 || mosha > 60) {
        printf("\nMosha nuk eshte brenda kufirit per pjesemarrje.\n");
    } else {
        printf("\nMosha eshte e vlefshme per pjesemarrje.\n");
    }

    // Klasifikimi sipas pikeve
    printf("Vleresimi: ");
    if (piket < 50) {
        printf("Nevojitet me shume ushtrim\n");
    } else if (piket < 80) {
        printf("Gati per vazhdim\n");
    } else {
        printf("Gati per sfide\n");
    }

    // Zgjedhja e punetorise me switch
    printf("Punetoria e zgjedhur: ");
    switch (opsioni) {
        case 1:
            printf("Programim bazik\n");
            break;
        case 2:
            printf("Algoritme\n");
            break;
        case 3:
            printf("Struktura te dhenash\n");
            break;
        default:
            printf("Opsion i pavlefshem\n");
    }

    // Output final
    printf("\n--- PERMBLEDHJE ---\n");
    printf("Mosha: %d\n", mosha);
    printf("Iniciali: %c\n", iniciali);
    printf("Piket: %.2lf\n", piket);
    printf("Opsioni: %d\n", opsioni);

    return 0;
} 
