#include <stdio.h>

int main() {

    int a = 10;
    float b = 5.5;
    double c = 10.12345;
    char d = 'A';

    printf("int: %d\n", a);
    printf("float: %f\n", b);
    printf("double: %lf\n", c);
    printf("char: %c\n", d);

    int mosha;
    printf("Shkruaj moshen: ");
    scanf("%d", &mosha);

    if (mosha >= 18) {
        printf("Madhor\n");
    } else {
        printf("I mitur\n");
    }

    int dita;
    printf("Vendos nje numer (1-3): ");
    scanf("%d", &dita);

    switch (dita) {
        case 1:
            printf("E Hene\n");
            break;
        case 2:
            printf("E Marte\n");
            break;
        case 3:
            printf("E Merkure\n");
            break;
        default:
            printf("Numer i pavlefshem\n");
    }

    return 0;
}
