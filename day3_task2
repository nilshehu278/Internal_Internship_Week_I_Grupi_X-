#include <stdio.h>

int main() {
    int start, end;

    int evenCount = 0, oddCount = 0;
    int evenSum = 0, oddSum = 0;
    int total = 0;

    // Marrja e input-it
    printf("Shkruani fillimin e intervalit: ");
    scanf("%d", &start);

    printf("Shkruani fundin e intervalit: ");
    scanf("%d", &end);

    // Validimi i intervalit
    if (start > end) {
        printf("Interval i pavlefshem! Fillimi duhet te jete <= fundi.\n");
        return 1;
    }

    // Loop nëpër interval
    for (int i = start; i <= end; i++) {
        total++;

        if (i % 2 == 0) {
            evenCount++;
            evenSum += i;
        } else {
            oddCount++;
            oddSum += i;
        }
    }

    // Output rezultatet
    printf("\n--- Rezultatet ---\n");
    printf("Intervali: [%d, %d]\n", start, end);
    printf("Totali i numrave: %d\n", total);

    printf("\nNumra çift: %d\n", evenCount);
    printf("Shuma e numrave çift: %d\n", evenSum);

    printf("\nNumra tek: %d\n", oddCount);
    printf("Shuma e numrave tek: %d\n", oddSum);

    // Krahasimi
    if (evenCount > oddCount) {
        printf("\nKa me shume numra CIFT.\n");
    } else if (oddCount > evenCount) {
        printf("\nKa me shume numra TEK.\n");
    } else {
        printf("\nNumrat CIFT dhe TEK jane te barabarte.\n");
    }

    return 0;
}
